# Ghostling 配置文件示例
# 复制到以下路径并去掉 .example 后缀（或改名为 config）后生效：
#   Windows: %APPDATA%\ghostling\config
#   Linux/macOS: ~/.config/ghostling/config
# 以 # 开头的行为注释。程序会自动热加载配置，也可用快捷键手动重载。

# 可选：激活某个 profile。也可以通过环境变量 GHOSTLING_PROFILE 指定。
# profile = work

# ---------------------------------------------------------------------------
# 终端（PTY）字体
# ---------------------------------------------------------------------------

# TrueType 字体路径（相对当前工作目录或绝对路径）。不设置则默认
# fonts/MapleMono-NF-CN-Regular.ttf（需在仓库根目录运行或自行放字体）。
# font_path = fonts/MapleMono-NF-CN-Regular.ttf

# 逻辑字号（点），会再按窗口 DPI 缩放。范围 6～256。默认 16。
font_size = 16

# 字形集合（影响启动耗时和内存）：
#   full    = 完整集合（默认，含 CJK + Nerd 扩展图标，约 42k codepoints）
#   compact = 常用 CJK + 全角 + 常见 Nerd 图标，约 28k codepoints
#   latin   = 拉丁/符号/框线 + powerline 分隔符（不含 CJK，约 2.4k codepoints）
#   han3500 = 拉丁/符号 + Nerd + 通用规范汉字一级字表（3500）
#   han6500 = 在 han3500 基础上加入二级字表（累计 6500）
#   han8105 = 在 han6500 基础上加入三级字表（累计 8105）
#             启动为 han3500/6500 时，运行中遇到缺字会自动升级到更高层
font_codepoint_set = full

# ---------------------------------------------------------------------------
# 侧栏 Tab（标题行字号比例与行高，单位：像素）
# ---------------------------------------------------------------------------

# Tab 标题 / × / + 相对 PTY 栅格字体的缩放系数。范围约 0.2～2.0。默认 0.8。
tab_title_font_scale = 0.8

# 每个 tab 上半部分高度：标题与关闭按钮所在行。范围 8～128。默认 18。
tab_title_h = 18

# 每个 tab 下半部分预留高度（当前为空白，供以后状态等）。范围 8～128。默认 24。
tab_reserved_h = 24

# ---------------------------------------------------------------------------
# 鼠标选择 / 剪贴板
# ---------------------------------------------------------------------------

# 鼠标左键拖选后，是否在松开时立即复制到系统剪贴板。默认 true。
selection_copy_on_select = true

# 本地选区的复制快捷键（当存在选区时优先复制，不再把 Ctrl+C 发送给 shell）：
#   ctrl+c（默认）
#   ctrl+shift+c
# macOS 上会把上述 Ctrl 自动映射为 Command（例如 Command+C）。
selection_copy_shortcut = ctrl+c

# 粘贴系统剪贴板到 PTY 的快捷键：
#   ctrl+shift+v（Windows/Linux 默认，推荐，不干扰 shell/TUI 的 ctrl+v）
#   ctrl+v（macOS 默认，会映射为 Command+V）
#   none（禁用终端级粘贴快捷键）
# macOS 上会把上述 Ctrl 自动映射为 Command（例如 Command+V）。
paste_shortcut = ctrl+v

# ---------------------------------------------------------------------------
# 全局快捷键（支持 primary/ctrl/shift/alt/super + key，none 可禁用）
# primary 在 macOS=Command，在 Windows/Linux=Ctrl
# ---------------------------------------------------------------------------

key_new_tab = primary+t
key_close_tab = primary+w
key_next_tab = primary+tab
key_prev_tab = primary+shift+tab
key_toggle_tab_strip = primary+b
key_reload_config = primary+shift+r

# profile 覆盖示例（同一文件内定义多套）:
# profile.work.font_size = 14
# profile.work.key_next_tab = alt+tab

# ---------------------------------------------------------------------------
# Agent 状态协议（运行时由外部工具发，不是配置项）
# ---------------------------------------------------------------------------
# 推荐统一使用 OSC 99：
#   printf '\033]99;v1|waiting_input|claude\007' > /dev/tty
# v1 格式：v1|<state>|<agent>
